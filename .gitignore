# Generated protobuf code — never commit, always regenerate
src/tbots/_pb/

# Downloaded binaries
tools/bin/*
!tools/bin/.gitkeep

# Game controller runtime state
tools/gc-data/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/

# Training artifacts
runs/
checkpoints/
wandb/
*.pt
*.onnx

# Editors / OS
.vscode/
.idea/
.DS_Store

# Game controller runtime state written into the mounted config dir.
# "Reset Match" in the UI also archives the old store under a UTC-stamped
# name, so ignore that whole family, not just the live file.
tools/gc-config/state-store.json.stream
tools/gc-config/*_state-store.json.stream
